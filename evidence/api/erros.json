{
  "fonte": "tests/api.spec.ts e regressao executada em 2026-10-06",
  "observacao": "assertions registra apenas os campos verificados. Em divergencias, esperado descreve o contrato e observado registra o retorno reproduzido.",
  "casos": [
    {
      "cenario": "Consultar produto inexistente",
      "requisicao": { "metodo": "GET", "url": "/api/produtos/NOPE" },
      "esperado": { "status": 404, "assertions": { "$.erro.codigo": "PRODUTO_NAO_ENCONTRADO" } },
      "observado": { "status": 404, "assertions": { "$.erro.codigo": "PRODUTO_NAO_ENCONTRADO" } },
      "resultado": "correto"
    },
    {
      "cenario": "Rejeitar lista de itens vazia",
      "requisicao": {
        "metodo": "POST",
        "url": "/api/pedidos",
        "body": {
          "cliente": {
            "nome": "Maria Silva",
            "email": "maria@exemplo.com",
            "cep": "01310-100"
          },
          "itens": []
        }
      },
      "esperado": { "status": 422, "assertions": { "$.erro.codigo": "ITENS_OBRIGATORIOS" } },
      "observado": { "status": 422, "assertions": { "$.erro.codigo": "ITENS_OBRIGATORIOS" } },
      "resultado": "correto"
    },
    {
      "cenario": "Rejeitar lista de itens ausente ou item que não é objeto",
      "requisicao": {
        "metodo": "POST",
        "url": "/api/pedidos",
        "bodyBase": {
          "cliente": {
            "nome": "Maria Silva",
            "email": "maria@exemplo.com",
            "cep": "01310-100"
          }
        },
        "variantes": [
          { "itens": "ausente", "codigoEsperado": "ITENS_OBRIGATORIOS" },
          { "itens": [null], "codigoEsperado": "ITEM_INVALIDO" }
        ]
      },
      "esperado": { "status": 422, "assertions": { "$.erro.codigo": "ITENS_OBRIGATORIOS ou ITEM_INVALIDO" } },
      "observado": { "status": 422, "assertions": { "$.erro.codigo": "ITENS_OBRIGATORIOS ou ITEM_INVALIDO" } },
      "resultado": "correto"
    },
    {
